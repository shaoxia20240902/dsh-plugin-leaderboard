[Unit]
Description=dsh-plugin leaderboard API
After=network.target mysqld.service

[Service]
Type=simple
WorkingDirectory=/opt/dsh-plugin-board
EnvironmentFile=/opt/dsh-plugin-board/.env
ExecStart=/usr/bin/node /opt/dsh-plugin-board/server.mjs
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
